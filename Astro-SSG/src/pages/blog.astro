---
import MainLayout from "@layouts/MainLayout.astro";
import { BLOG_POSTS } from "@data/Blog";

const [featuredPost, ...recentPosts] = BLOG_POSTS;
---
<MainLayout>
  <main class="blog-home">
    <section class="blog-hero">
      <p class="eyebrow">Bitacora frontend</p>
      <h1>Ideas para construir mejor la web.</h1>
      <p class="intro">
        Un espacio para explorar arquitectura, rendimiento y componentes desde la practica.
      </p>
      <a class="primary-link" href="/blog/articles">Explorar articulos</a>
    </section>

    <section class="featured-post" aria-labelledby="featured-title">
      <div>
        <p class="eyebrow">Articulo destacado</p>
        <h2 id="featured-title">{featuredPost.title}</h2>
        <p>{featuredPost.excerpt}</p>
      </div>
      <div class="post-meta">
        <span>{featuredPost.category}</span>
        <span>{featuredPost.readTime}</span>
      </div>
    </section>

    <section class="recent-posts" aria-labelledby="recent-title">
      <div class="section-heading">
        <p class="eyebrow">Para leer despues</p>
        <h2 id="recent-title">Nuevas conversaciones</h2>
      </div>
      <div class="post-grid">
        {recentPosts.map((post) => (
          <article class="post-card">
            <p class="post-category">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <small>{post.publishedAt} · {post.readTime}</small>
          </article>
        ))}
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .blog-home { max-width: 1100px; margin: 0 auto; color: #172121; }
  .blog-hero { padding: 4rem 0 5rem; max-width: 760px; }
  .eyebrow, .post-category { color: #b64b2a; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3 { font-family: Georgia, serif; }
  h1 { font-size: clamp(2.8rem, 7vw, 5.8rem); line-height: .98; margin: 1rem 0; }
  h2 { font-size: 2rem; }
  .intro { color: #52605e; font-size: 1.2rem; line-height: 1.6; max-width: 580px; }
  .primary-link { background: #172121; color: #fff; display: inline-block; margin-top: 1.5rem; padding: .8rem 1.2rem; text-decoration: none; }
  .featured-post { background: #e7ede8; display: flex; gap: 2rem; justify-content: space-between; padding: 2rem; }
  .featured-post h2 { margin: .5rem 0; }
  .featured-post p:not(.eyebrow) { color: #52605e; line-height: 1.6; max-width: 650px; }
  .post-meta { align-items: flex-end; display: flex; flex-direction: column; gap: .5rem; min-width: 90px; }
  .post-meta span:last-child, small { color: #52605e; }
  .recent-posts { padding: 5rem 0; }
  .section-heading h2 { margin-top: .5rem; }
  .post-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .post-card { border-top: 1px solid #cbd5cf; padding-top: 1.25rem; }
  .post-card h3 { font-size: 1.5rem; margin: .7rem 0; }
  .post-card p:not(.post-category) { color: #52605e; line-height: 1.5; }
  @media (max-width: 700px) {
    .featured-post { flex-direction: column; }
    .post-meta { align-items: flex-start; flex-direction: row; }
    .post-grid { grid-template-columns: 1fr; }
  }
</style>