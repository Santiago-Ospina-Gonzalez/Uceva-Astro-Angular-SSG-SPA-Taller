---
import MainLayout from "@layouts/MainLayout.astro";

const principles = [
  'Explicar decisiones tecnicas con ejemplos concretos.',
  'Medir el rendimiento antes de proponer optimizaciones.',
  'Diseñar componentes que puedan crecer sin perder claridad.',
];
---
<MainLayout>
  <main class="about-page">
    <section class="about-intro">
      <p class="eyebrow">Sobre este espacio</p>
      <h1>Una bitacora para entender lo que construimos.</h1>
      <p>Este blog convierte preguntas de frontend en conversaciones cortas sobre arquitectura, rendimiento y calidad de codigo.</p>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div>
        <p class="eyebrow">Forma de trabajo</p>
        <h2 id="principles-title">Tres ideas que guian cada nota</h2>
      </div>
      <ol>
        {principles.map((principle, index) => <li><span>0{index + 1}</span>{principle}</li>)}
      </ol>
    </section>
  </main>
</MainLayout>

<style>
  .about-page { max-width: 1100px; margin: 0 auto; color: #172121; }
  .about-intro { max-width: 800px; padding: 4rem 0 6rem; }
  .eyebrow { color: #b64b2a; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2 { font-family: Georgia, serif; }
  h1 { font-size: clamp(2.7rem, 7vw, 5.6rem); line-height: 1; margin: 1rem 0; }
  .about-intro p:last-child { color: #52605e; font-size: 1.2rem; line-height: 1.7; max-width: 640px; }
  .principles { border-top: 1px solid #cbd5cf; display: grid; gap: 3rem; grid-template-columns: 1fr 1.5fr; padding: 2rem 0 5rem; }
  .principles h2 { font-size: 2rem; margin-top: .7rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid #cbd5cf; display: flex; gap: 1rem; line-height: 1.5; padding: 1.25rem 0; }
  li span { color: #b64b2a; font-family: Georgia, serif; }
  @media (max-width: 700px) { .principles { grid-template-columns: 1fr; } }
</style>