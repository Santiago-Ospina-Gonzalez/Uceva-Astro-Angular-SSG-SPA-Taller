---
import MainLayout from "@layouts/MainLayout.astro";
import { BLOG_POSTS } from "@data/Blog";
---
<MainLayout>
  <main class="articles-page">
    <header class="page-heading">
      <p class="eyebrow">Archivo</p>
      <h1>Todos los articulos</h1>
      <p>Notas breves para tomar mejores decisiones al crear productos digitales.</p>
    </header>

    <div class="articles-list">
      {BLOG_POSTS.map((post, index) => (
        <article class="article-row">
          <span class="article-number">0{index + 1}</span>
          <div>
            <p class="post-category">{post.category} · {post.readTime}</p>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
          </div>
          <time>{post.publishedAt}</time>
        </article>
      ))}
    </div>
  </main>
</MainLayout>

<style>
  .articles-page { max-width: 1100px; margin: 0 auto; color: #172121; }
  .page-heading { border-bottom: 1px solid #cbd5cf; padding: 3rem 0; }
  .eyebrow, .post-category { color: #b64b2a; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2 { font-family: Georgia, serif; }
  h1 { font-size: clamp(2.5rem, 6vw, 5rem); margin: .8rem 0; }
  .page-heading p:last-child, .article-row p:last-child { color: #52605e; line-height: 1.6; }
  .articles-list { padding: 1rem 0 4rem; }
  .article-row { align-items: start; border-bottom: 1px solid #cbd5cf; display: grid; gap: 1.5rem; grid-template-columns: 3rem 1fr 170px; padding: 2rem 0; }
  .article-number { color: #b64b2a; font-family: Georgia, serif; font-size: 1.4rem; }
  .article-row h2 { font-size: 1.8rem; margin: .7rem 0; }
  .article-row time { color: #52605e; font-size: .9rem; text-align: right; }
  @media (max-width: 700px) {
    .article-row { grid-template-columns: 2rem 1fr; }
    .article-row time { grid-column: 2; text-align: left; }
  }
</style>